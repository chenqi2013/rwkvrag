# Native RWKV pipeline; existing is available only for regression comparisons.
RWKVRAG_RAG_PIPELINE=rwkv
RWKVRAG_OPENSEARCH_URL=http://127.0.0.1:9200
RWKVRAG_OPENSEARCH_INDEX=rwkvrag-native-v1
RWKVRAG_OPENSEARCH_SHARDS=1
RWKVRAG_OPENSEARCH_REPLICAS=0
RWKVRAG_OPENSEARCH_BULK_SIZE=500
RWKVRAG_MONGO_URL=mongodb://127.0.0.1:27017
RWKVRAG_MONGO_DATABASE=rwkvrag_native
RWKVRAG_UPLOAD_DIR=data/admin-uploads
RWKVRAG_FINEWIKI_IMPORT_ROOTS=data/finewiki
RWKVRAG_MAX_UPLOAD_BYTES=104857600
RWKVRAG_TASK_WORKERS=2
RWKVRAG_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

RWKVRAG_NATIVE_TRANSPORT=rwkvos_batch
RWKVRAG_NATIVE_BASE_URL=https://api-3b.rwkvos.com/v1
RWKVRAG_NATIVE_MODEL=rwkv7-g1j-2.9b-20260831-ctx16384
RWKVRAG_NATIVE_API_KEY=
RWKVRAG_NATIVE_CONTEXT_WINDOW_TOKENS=16384
RWKVRAG_NATIVE_MAX_CONCURRENCY=32
RWKVRAG_NATIVE_TIMEOUT_SECONDS=600
# Tested external 2.9B development baseline; quality has NOT passed acceptance.
RWKVRAG_NATIVE_PLANNER_PREFILL="<think></think"
RWKVRAG_NATIVE_RESOLVER_PREFILL="<think></think"
RWKVRAG_NATIVE_WRITER_PREFILL="<think></think"
RWKVRAG_NATIVE_PLAN_PROTOCOL=queries_fields
RWKVRAG_NATIVE_RESOLVER_PROTOCOL=task_units
RWKVRAG_NATIVE_TASK_SOURCE=queries
RWKVRAG_NATIVE_CANDIDATE_ORDER=query_round_robin
RWKVRAG_RWKVOS_BATCH_SIZE=8
RWKVRAG_RWKVOS_BATCH_WAIT_MS=5
RWKVRAG_RWKVOS_PREFILL_MODE=complete
RWKVRAG_RWKVOS_STOP_TOKENS=[0]
# Supply credentials locally; never commit .env or copy secrets into traces.
RWKVRAG_RWKVOS_CF_ACCESS_CLIENT_ID=
RWKVRAG_RWKVOS_CF_ACCESS_CLIENT_SECRET=
# Omit STATE_ID for the zero-state baseline. An empty/expired ID is not a state.
# RWKVRAG_RWKVOS_STATE_ID=replace-with-valid-compatible-state-id
# Optional measured input budget; disabled preserves the published baseline.
RWKVRAG_RWKVOS_COUNT_INPUT_TOKENS=false
# Requires count=true. This is an APPLICATION input limit, not a server limit.
# RWKVRAG_RWKVOS_INPUT_TOKEN_LIMIT=8192
RWKVRAG_GENERATION_MAX_TOKENS=2048
RWKVRAG_NATIVE_PLANNER_MAX_TOKENS=1024
RWKVRAG_NATIVE_RESOLVER_MAX_TOKENS=1024
RWKVRAG_CANDIDATE_K=80
RWKVRAG_DEFAULT_TOP_K=5
RWKVRAG_NATIVE_RESOLVER_SOURCES=80
RWKVRAG_NATIVE_RESOLVER_WINDOW_CHARACTERS=1200
RWKVRAG_NATIVE_RESOLVER_OVERLAP_CHARACTERS=180
RWKVRAG_NATIVE_RESOLVER_BATCH_CHARACTERS=6000
RWKVRAG_NATIVE_MAX_QUERIES=6
RWKVRAG_NATIVE_MAX_FIELDS=12
RWKVRAG_NATIVE_INGEST_CHUNK_CHARACTERS=2400
RWKVRAG_NATIVE_INGEST_OVERLAP_CHARACTERS=180
